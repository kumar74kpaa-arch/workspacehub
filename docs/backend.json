{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "photoURL": {
          "type": "string",
          "format": "uri",
          "description": "URL of the user's profile picture."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "description": "The user's role, either 'user' or 'admin'.",
          "enum": [
            "user",
            "admin"
          ]
        },
        "provider": {
          "type": "string",
          "description": "The authentication provider for the user.",
          "enum": ["google", "password"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The creation timestamp of the user account."
        }
      },
      "required": [
        "displayName",
        "email",
        "role",
        "provider",
        "createdAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Represents a booking for a workspace.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The ID of the user who made the booking."
        },
        "userName": {
          "type": "string",
          "description": "The name of the user who made the booking."
        },
        "workspaceId": {
          "type": "string",
          "description": "The ID of the workspace being booked."
        },
        "workspaceName": {
          "type": "string",
          "description": "The name of the workspace at the time of booking."
        },
        "workspaceType": {
          "type": "string",
          "description": "The type of workspace.",
          "enum": ["desk", "room"]
        },
        "date": {
          "type": "string",
          "format": "date",
          "description": "The date of the booking in YYYY-MM-DD format."
        },
        "startTime": {
          "type": "string",
          "format": "date-time",
          "description": "The start time of the booking."
        },
        "endTime": {
          "type": "string",
          "format": "date-time",
          "description": "The end time of the booking."
        },
        "status": {
          "type": "string",
          "description": "The status of the booking.",
          "enum": ["confirmed", "pending", "cancelled"]
        },
        "isExtendedHours": {
            "type": "boolean",
            "description": "Indicates if the booking falls into extended hours."
        },
        "pricingType": {
            "type": "string",
            "description": "The pricing type of the booking.",
            "enum": ["standard", "extended"]
        }
      },
      "required": [
        "userId",
        "userName",
        "workspaceId",
        "workspaceName",
        "workspaceType",
        "date",
        "startTime",
        "endTime",
        "status"
      ]
    }
  },
  "auth": {
    "providers": [
      "email-password",
      "google.com"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores public user profile data."
    },
    "/bookings/{bookingId}": {
      "schema": {
        "$ref": "#/entities/Booking"
      },
      "description": "Stores all workspace bookings made by users."
    }
  }
}
